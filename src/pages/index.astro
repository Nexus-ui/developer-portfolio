---
import '../styles/global.css';

const title = 'Developer Portfolio';
const subtitle = 'Software Engineering | Salesforce | Agentic AI';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">WELCOME TO MY PORTFOLIO</p>
<h1 class="text-5xl font-bold text-cyan-400">
  {title}
</h1>   
	<p>{subtitle}</p>
      <p class="description">
        Building modern software solutions, Salesforce applications,
        and intelligent AI systems.
      </p>
      <a
        href="https://github.com/Nexus-ui"
        target="_blank"
        rel="noopener noreferrer"
      >
        Explore my GitHub
      </a>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: #0b1120;
    color: #f8fafc;
    font-family: system-ui, sans-serif;
  }

  main {
    max-width: 700px;
    padding: 32px;
  }

  .eyebrow {
    color: #38bdf8;
    font-size: 12px;
    letter-spacing: 3px;
  }

  h1 {
    font-size: clamp(40px, 8vw, 72px);
    margin: 16px 0;
  }

  .description {
    color: #94a3b8;
    line-height: 1.7;
  }

  a {
    display: inline-block;
    margin-top: 24px;
    color: #38bdf8;
  }
</style>
